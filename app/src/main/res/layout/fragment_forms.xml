<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forms_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="Forms-screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/forms_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/forms_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/forms_input_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/text_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:contentDescription="text-input"
            android:hint="@string/forms_input_hint"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:saveEnabled="false"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/forms_input_result_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/input_text_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="input-text-result"
            android:minHeight="24dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/forms_switch_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/form_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:checked="false"
            android:contentDescription="switch"
            android:saveEnabled="false" />

        <TextView
            android:id="@+id/switch_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="switch-text"
            android:text="@string/forms_switch_off"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/forms_dropdown_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/dropdown_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:contentDescription="Dropdown"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/dropdown_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/forms_dropdown_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/dropdown_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="dropdown-chevron"
                android:src="@drawable/ic_arrow_drop_down" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/forms_buttons_label"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_active"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/wdio_orange"
                android:contentDescription="button-Active"
                android:text="@string/forms_button_active"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/button_inactive"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="button-Inactive"
                android:enabled="false"
                android:text="@string/forms_button_inactive"
                android:textColor="@color/inactive_text"
                app:backgroundTint="@color/inactive_bg" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
