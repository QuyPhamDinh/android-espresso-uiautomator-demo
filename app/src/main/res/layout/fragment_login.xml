<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/login_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="Login-screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/login_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/login_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/login_header"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/button_login_container"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="button-login-container"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/login_tab"
                android:textColor="@color/wdio_orange"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/button_sign_up_container"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="button-sign-up-container"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/signup_tab"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray" />

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:contentDescription="input-email"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/error_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_invalid_email"
            android:textColor="@color/error_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:contentDescription="input-password"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/error_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_invalid_password"
            android:textColor="@color/error_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/input_repeat_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:contentDescription="input-repeat-password"
            android:hint="@string/repeat_password_hint"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_repeat_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/error_password_mismatch"
            android:textColor="@color/error_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/biometric_hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/biometric_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/button_biometric"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="button-biometric"
            android:src="@drawable/ic_fingerprint"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/wdio_orange"
            android:contentDescription="button-LOGIN"
            android:text="@string/login_button"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/button_sign_up"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/wdio_orange"
            android:contentDescription="button-SIGN UP"
            android:text="@string/signup_button"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
